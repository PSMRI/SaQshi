<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <!-- ===============================
         Security & Upload Limits
    ================================ -->
    <security>
      <!-- Do not disclose the IIS version in response headers. -->
      <requestFiltering removeServerHeader="true">
        <!-- 2 GB max upload size -->
        <requestLimits maxAllowedContentLength="2097152000" />
        <!--
          Reject methods the application does not implement before requests
          reach PHP. In particular, OPTIONS must not advertise an unnecessary
          endpoint surface; this is a same-origin application and does not
          require CORS preflight handling.
        -->
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="PUT" allowed="true" />
          <add verb="PATCH" allowed="true" />
          <add verb="DELETE" allowed="true" />
        </verbs>
        <hiddenSegments>
          <!-- Technical documentation is retained in source control, not exposed by production IIS. -->
          <add segment="docs" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ===============================
         HTTP Security Headers
    ================================ -->
    <httpProtocol>
      <customHeaders>
        <!-- Apply these protections to IIS-served static files as well as PHP responses. -->
        <remove name="X-Powered-By" />
        <!-- Remove the obsolete legacy filter header if it is inherited from IIS. -->
        <remove name="X-XSS-Protection" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'" />
      </customHeaders>
    </httpProtocol>

    <!-- ===============================
         Static Content (YAML for Swagger)
    ================================ -->
    <staticContent>
      <!-- Static fragments are fetched directly by the component loader. -->
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <mimeMap fileExtension=".yaml" mimeType="application/yaml" />
      <mimeMap fileExtension=".yml"  mimeType="application/yaml" />
    </staticContent>

    <!-- ===============================
         URL Rewrite (REST APIs)
    ================================ -->
    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <!-- Local development commonly runs without a TLS certificate. -->
            <add input="{HTTP_HOST}" pattern="^nhmsaqshi\.piramalswasthya\.org(?::\d+)?$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Use login as default page" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="ui/login.html" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Hide technical documentation" stopProcessing="true">
          <match url="^(?:gitbook\.html|readme\.md)$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="RemovePhpExtension" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite"
                  url="{R:1}.php"
                  appendQueryString="true" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Append a UTF-8 charset after IIS has selected the MIME type. -->
        <rule name="Add UTF8 charset to HTML" preCondition="PlainHtmlResponse">
          <match serverVariable="RESPONSE_Content_Type" pattern="^text/html$" />
          <action type="Rewrite" value="text/html; charset=utf-8" />
        </rule>
        <rule name="Add UTF8 charset to JSON" preCondition="PlainJsonResponse">
          <match serverVariable="RESPONSE_Content_Type" pattern="^application/json$" />
          <action type="Rewrite" value="application/json; charset=utf-8" />
        </rule>
        <!-- HSTS is emitted only on HTTPS responses, never on the HTTP redirect. -->
        <rule name="Add HSTS on HTTPS" preCondition="IsHttps">
          <match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*" />
          <action type="Rewrite" value="max-age=31536000; includeSubDomains; preload" />
        </rule>
        <preConditions>
          <preCondition name="PlainHtmlResponse">
            <add input="{RESPONSE_Content_Type}" pattern="^text/html$" />
          </preCondition>
          <preCondition name="PlainJsonResponse">
            <add input="{RESPONSE_Content_Type}" pattern="^application/json$" />
          </preCondition>
          <preCondition name="IsHttps">
            <add input="{HTTPS}" pattern="on" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

  </system.webServer>

</configuration>
