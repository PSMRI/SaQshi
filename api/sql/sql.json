DROP EVENT IF EXISTS ev_close_completed_assessment;
DELIMITER $$

CREATE EVENT ev_close_completed_assessment
ON SCHEDULE EVERY 1 HOUR
ON COMPLETION PRESERVE
ENABLE
DO
BEGIN
    UPDATE assessment_desc ad
    JOIN state_dash_view sdv
      ON sdv.fac_id = ad.fac_id_fk
     AND (sdv.ass_period_id IS NULL OR ad.id = sdv.ass_period_id)
    SET
        ad.ass_close_dt = CURDATE(),
        ad.current_assment = 0
    WHERE sdv.tot = sdv.obt
      AND ad.ass_close_dt IS NULL
      AND ad.current_assment = 1;
END$$

DELIMITER ;